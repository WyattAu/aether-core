      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(aether_stream_events_total[5m])) by (stream)",
          "legendFormat": "{{stream}}",
          "refId": "A"
