#!/usr/bin/env bash
# Aether Core pre-commit hook
# Runs full quality gate before allowing a commit.
# Covers: formatting, clippy, compilation, tests, docs, emoji detection.
set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

log_step() { echo -e "${GREEN}[pre-commit]${NC} $1"; }
log_fail() { echo -e "${RED}[pre-commit]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[pre-commit]${NC} $1"; }

# Detect what changed
RUST_CHANGED=$(git diff --cached --name-only --diff-filter=ACMR '*.rs' 'Cargo.toml' 'Cargo.lock' 'rust-toolchain.toml' 2>/dev/null | head -1)
DOC_CHANGED=$(git diff --cached --name-only --diff-filter=ACMR '*.md' 2>/dev/null | head -1)

STEPS=0
TOTAL=0

if [ -n "$RUST_CHANGED" ]; then
    TOTAL=$((TOTAL + 5))
fi
if [ -n "$DOC_CHANGED" ]; then
    TOTAL=$((TOTAL + 1))
fi
if [ "$TOTAL" -eq 0 ]; then
    log_step "No Rust or documentation changes detected. Skipping quality gate."
    exit 0
fi

# --- Rust quality gate ---
if [ -n "$RUST_CHANGED" ]; then
    log_step "Rust changes detected. Running full quality gate..."

    # Step 1: Check formatting
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Checking code formatting..."
    if ! cargo fmt --all -- --check; then
        log_fail "Formatting errors detected. Run 'cargo fmt --all' to fix."
        exit 1
    fi

    # Step 2: Clippy lint
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Running clippy lints..."
    if ! cargo clippy --workspace --all-features -- -D warnings 2>&1; then
        log_fail "Clippy errors detected. Fix warnings before committing."
        exit 1
    fi

    # Step 3: Compile check
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Checking compilation..."
    if ! cargo check --workspace --all-features 2>&1; then
        log_fail "Compilation errors detected."
        exit 1
    fi

    # Step 4: Run tests
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Running test suite..."
    if ! cargo test --workspace --all-features 2>&1; then
        log_fail "Test failures detected. All tests must pass before committing."
        exit 1
    fi

    # Step 5: Documentation build
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Checking documentation..."
    if ! cargo doc --workspace --no-deps 2>&1; then
        log_fail "Documentation errors detected."
        exit 1
    fi

    # Step 6: Forbidden pattern check
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Checking for forbidden patterns..."
    TOTAL=$((TOTAL + 1))
    if grep -rn 'todo!\|unimplemented!\|generate_mock\|SimulatedLogStreamer' crates/ 2>/dev/null; then
        log_fail "Forbidden patterns detected (todo!, unimplemented!, stubs). Remove before committing."
        exit 1
    fi
    log_step "No forbidden patterns detected."
fi

# --- Documentation quality gate ---
if [ -n "$DOC_CHANGED" ]; then
    STEPS=$((STEPS + 1))
    log_step "${STEPS}/${TOTAL}: Scanning documentation for emoji characters..."
    EMOJI_FILES=$(git diff --cached --name-only --diff-filter=ACMR '*.md' | xargs grep -lP '[\x{1F300}-\x{1F9FF}\x{1F600}-\x{1F64F}\x{1F680}-\x{1F6FF}\x{1F900}-\x{1F9FF}\x{2600}-\x{26FF}\x{2705}\x{2714}\x{2716}\x{274C}\x{274E}\x{2753}-\x{2755}\x{2795}-\x{2797}\x{2B50}\x{23F0}\x{23F3}\x{26A0}\x{1F534}-\x{1F7E1}\x{1F4DD}\x{1F527}\x{1F310}\x{1F9EA}\x{1F4D6}\x{1F4AC}\x{1F4C4}\x{1F512}\x{1F4BE}\x{1F517}\x{1F51D}]' 2>/dev/null || true)
    if [ -n "$EMOJI_FILES" ]; then
        log_fail "Emoji characters detected in documentation files:"
        echo "$EMOJI_FILES"
        log_fail "Remove all emoji characters before committing."
        exit 1
    fi
    log_step "No emoji characters detected."
fi

log_step "All quality gates passed. Commit allowed."
exit 0
