#!/usr/bin/env bash
# Aether pre-push hook
# Full quality gate: formatting, clippy, full test suite.
# Blocks push if any test fails.
set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

log_step() { echo -e "${GREEN}[pre-push]${NC} $1"; }
log_fail() { echo -e "${RED}[pre-push]${NC} $1"; }

# Step 1: Check formatting
log_step "1/4: Checking code formatting..."
if ! cargo fmt --all -- --check; then
    log_fail "Formatting errors detected. Run 'cargo fmt --all' to fix."
    exit 1
fi

# Step 2: Clippy lint
log_step "2/4: Running clippy lints..."
if ! cargo clippy --workspace --all-features -- -D warnings 2>&1; then
    log_fail "Clippy errors detected. Fix warnings before pushing."
    exit 1
fi

# Step 3: Full test suite (unit + integration + property + fuzz)
log_step "3/4: Running full test suite..."
if ! cargo test --workspace --all-features 2>&1; then
    log_fail "Test failures detected. Fix before pushing."
    exit 1
fi

# Step 4: Documentation build
log_step "4/4: Building documentation..."
if ! cargo doc --workspace --no-deps 2>&1; then
    log_fail "Documentation build failed."
    exit 1
fi

log_step "All pre-push checks passed."
exit 0
