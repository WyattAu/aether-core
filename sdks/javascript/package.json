{
    "name": "@aether/sdk",
    "version": "1.6.0",
    "description": "JavaScript/TypeScript SDK for Aether Actor Runtime",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "test": "jest",
        "lint": "eslint src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "docs": "typedoc",
        "docs:serve": "typedoc --serve",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "aether",
        "actor",
        "wasm",
        "serverless"
    ],
    "files": [
        "dist/",
        "src/"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WyattAu/aether-core.git",
        "directory": "sdks/javascript"
    },
    "homepage": "https://github.com/WyattAu/aether-core#readme",
    "bugs": {
        "url": "https://github.com/WyattAu/aether-core/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.0.0",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^10.8.0",
        "jest": "^29.0.0",
        "ts-jest": "^29.0.0",
        "typedoc": "^0.27.9",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0"
    }
}
